# Where the backend API lives.
#
# Leave EMPTY for same-origin — in dev the Vite proxy (vite.config.ts) forwards
# /api to localhost:4000, and in a single-domain production deploy the API is
# already on the same host. Empty is the safe default and needs no CORS.
#
# Set it to an absolute URL when the API is on a different host, e.g.
#   VITE_API_URL=http://localhost:4000        (bypass the dev proxy)
#   VITE_API_URL=http://192.168.1.20:4000     (open the app from your phone)
#   VITE_API_URL=https://api.yourdomain.com   (separate backend deploy)
VITE_API_URL=

# NOTE: everything VITE_-prefixed is compiled into the JS bundle and is public.
# Never put the Google API key or any secret here — the Places key stays in
# server/.env, and the map uses OpenStreetMap tiles, which need no key.
